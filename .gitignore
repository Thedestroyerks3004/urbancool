# Secrets -- never committed
credentials/
.cdsapirc
*.pem
*.key

# Raw geospatial source data and model training outputs -- large, regenerable via the
# pipeline scripts, not needed to run the app. backend/cache/ is the ONE exception: it's
# the pre-built feature stack the running app actually reads at startup, so it IS
# committed (via Git LFS -- see .gitattributes) so a fresh clone works without also
# needing the multi-GB source data or a from-scratch rebuild.
data/
model_output/
model_output_*/
catboost_info/
pipeline/**/__pycache__/
**/__pycache__/
*.pyc

# Runtime/build artifacts
.run-logs/
frontend/node_modules/
frontend/.next/
frontend/tsconfig.tsbuildinfo
frontend/scripts/*.png

# Editor/session state
.claude/
